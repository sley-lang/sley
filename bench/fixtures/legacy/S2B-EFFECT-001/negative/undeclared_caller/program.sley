module app.cfgeffect

export task fetch_config -> Text uses FileRead {
  take gate files: Gate<FileRead>
  return call fs.read_text("config/settings.bin")
}

export task render_config -> Text {
  return call fetch_config()
}

export task pure_greet -> Text {
  take name: Text
  return "hello, " + name
}

task main -> Text {
  return call render_config()
}
