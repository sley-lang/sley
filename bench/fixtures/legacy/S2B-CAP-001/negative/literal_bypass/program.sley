module app.capnarrow

export task read_exact -> Text uses FileRead {
  take gate files: Gate<FileRead>
  return call fs.read_text("config/settings.bin")
}

export task read_param -> Text uses FileRead {
  take gate files: Gate<FileRead>
  take path: Text
  return call fs.read_text(path)
}

task main -> Text uses FileRead {
  return call read_exact()
}
