fn parse_int(chars: Vec<i64>) -> Result<i64,ParseError> {
    if len(chars) == 0 {
        return err(Empty)
    }
    var sign = 1
    var start = 0
    if chars[0] == 45 {
        sign = -1
        start = 1
        if len(chars) == 1 {
            return err(LoneMinus)
        }
    }
    var value = 0
    for i in to(u64, start)..len(chars) {
        let c = chars[i]
        if c < 48 or c > 57 {
            return err(NotDigit)
        }
        value = value * 10 + (c - 48)
    }
    ok(sign * value)
}
